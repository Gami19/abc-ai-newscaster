# ─────────────────────────────────────
# AI プロバイダー選択
# openai | azure | bedrock
# ─────────────────────────────────────
AI_PROVIDER=openai

# ─────────────────────────────────────
# OpenAI
# ─────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────
# Azure OpenAI
# ─────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_TTS_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ─────────────────────────────────────
# Amazon Bedrock
# ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BEDROCK_MODEL_ID=

# ─────────────────────────────────────
# TTS プロバイダー選択
# openai | azure
# ─────────────────────────────────────
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=0.95

# ─────────────────────────────────────
# 動画生成（Day 3・ブラウザ側で参照）
# ffmpeg | mediarecorder | fallback
# Day 3 検証: COEP 有効 + ffmpeg.wasm 動作時は ffmpeg、
# 失敗時は mediarecorder を推奨
# ─────────────────────────────────────
NEXT_PUBLIC_VIDEO_MODE=mediarecorder

# ─────────────────────────────────────
# デモ用 MOCK（APIキー不要で体験可能）
# カメラ撮影は実機のまま（MOCK 対象外）
# ─────────────────────────────────────
DEMO_MOCK_SCRIPT=false
DEMO_MOCK_TTS=false
DEMO_MOCK_DELAY_MS=1500
DEMO_MOCK_TTS_AUDIO_PATH=public/sounds/demo-tts.wav
